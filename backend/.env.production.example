# `backend/.env.production`으로 복사한 뒤 환경별 값으로 교체한다. 이 파일에는 실제 비밀값을 저장하지 않는다.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DB_NAME=territorial_auction
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_SSL_MODE=disable
POSTGRES_DB=territorial_auction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# 프론트엔드가 별도 도메인인 외부 배포 시 실제 HTTPS 주소로 교체한다.
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_PASSWORD=
REDIS_SSL=false
# OAuth를 사용하지 않는 로컬 검증에는 dummy를 유지한다. 외부 배포 시 각 공급자 콘솔의 실제 값으로 교체한다.
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
KAKAO_CLIENT_ID=dummy
KAKAO_CLIENT_SECRET=dummy
ADMIN_IP_ALLOWLIST=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
