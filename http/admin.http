# 관리 콘솔(admin-service). 게이트웨이(:8090)가 /api/v1/admin/** 를 admin-service로 라우팅.
# 인증: 일반 유저 토큰이 아니라 admin 자체 로그인 토큰을 accessToken에 넣어 사용한다.
#   POST /api/v1/admin/auth/login → (TOTP) → 발급 토큰을 http-client.env.json의 accessToken에 저장
baseUrl = http://localhost:8090

### 밸런스 설정 조회 (카탈로그 + 현재값/기본값)
GET {{baseUrl}}/api/v1/admin/settings/balance
Authorization: Bearer {{accessToken}}

### 밸런스 설정 수정 (예: 수리 GP/HP를 3으로)
PATCH {{baseUrl}}/api/v1/admin/settings/balance
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "key": "REPAIR_GP_PER_HP", "value": 3 }

### 밸런스 설정 수정 (성 주둔 수용량을 6으로)
PATCH {{baseUrl}}/api/v1/admin/settings/balance
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "key": "GARRISON_CAP_CASTLE", "value": 6 }

### 경매 전역 토글 조회
GET {{baseUrl}}/api/v1/admin/settings/auction
Authorization: Bearer {{accessToken}}


# ── (자동 보강) 누락 엔드포인트 ──

